<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Number Guessing Game – Nicole B. Raz</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet"/>
  <style>
    :root { --pink:#f472b6; --pink-dark:#db2777; --glow:rgba(244,114,182,.15); --bg:#0d0d14; --bg3:#1a1a2e; --surface:#1e1e30; --border:rgba(244,114,182,.18); --text:#f1f0f8; --muted:#a9a7b5; --win:#4ade80; --lose:#f87171; }
    *,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Inter',sans-serif; background:var(--bg); color:var(--text); line-height:1.6; min-height:100vh; padding:24px 16px 48px; }
    :focus-visible { outline:2px solid var(--pink); outline-offset:3px; }
    .wrap { max-width:560px; margin:0 auto; }
    .back { display:inline-flex; align-items:center; min-height:44px; color:var(--pink); font-weight:600; font-size:.95rem; text-decoration:none; }
    h1 { font-family:'Playfair Display',serif; font-size:clamp(1.8rem,7vw,2.4rem); line-height:1.15; margin:8px 0 6px; }
    h1 span { color:var(--pink); }
    .sub { color:var(--muted); margin-bottom:24px; }
    .card { background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:22px; margin-bottom:16px; }
    .coins { display:flex; justify-content:space-between; align-items:center; }
    .coins .label { color:var(--muted); font-size:.85rem; font-weight:600; }
    .coins .value { font-size:2rem; font-weight:700; color:var(--pink); line-height:1.1; }
    h2 { font-size:1rem; margin-bottom:10px; }
    .picker { display:grid; grid-template-columns:repeat(6,1fr); gap:8px; margin-bottom:18px; }
    .picker button { min-height:48px; border-radius:10px; border:1px solid var(--border); background:var(--bg3); color:var(--text); font:inherit; font-size:1.1rem; font-weight:700; cursor:pointer; transition:background .15s, border-color .15s; }
    .picker button:hover { border-color:var(--pink); }
    .picker button[aria-pressed="true"] { background:var(--pink-dark); border-color:var(--pink); color:#fff; }
    .bet-row { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:6px; }
    input[type=number] { flex:1; min-width:120px; min-height:48px; padding:0 14px; border-radius:10px; border:1px solid var(--border); background:var(--bg3); color:var(--text); font:inherit; font-size:1rem; }
    .chip { min-height:48px; padding:0 14px; border-radius:10px; border:1px solid var(--border); background:var(--glow); color:var(--pink); font:inherit; font-weight:600; cursor:pointer; }
    .hint { font-size:.82rem; color:var(--muted); }
    .btn { width:100%; min-height:52px; margin-top:18px; border:none; border-radius:12px; background:linear-gradient(135deg,var(--pink-dark),#ec4899); color:#fff; font:inherit; font-size:1rem; font-weight:700; cursor:pointer; }
    .btn:disabled { opacity:.5; cursor:not-allowed; }
    .btn.secondary { background:var(--glow); color:var(--pink); border:1px solid var(--border); }
    .error { color:var(--lose); font-size:.88rem; min-height:1.4em; margin-top:8px; }
    .result { text-align:center; }
    .draws { display:flex; justify-content:center; gap:14px; margin:6px 0 14px; }
    .die { width:72px; height:72px; border-radius:14px; background:var(--bg3); border:2px solid var(--border); display:flex; flex-direction:column; align-items:center; justify-content:center; }
    .die b { font-size:1.9rem; line-height:1; }
    .die small { font-size:.7rem; color:var(--muted); margin-top:4px; }
    .die.hit { border-color:var(--win); }
    .die.miss { border-color:var(--lose); }
    .msg { font-weight:700; font-size:1.1rem; }
    .msg.win { color:var(--win); } .msg.lose { color:var(--lose); }
    .rules { color:var(--muted); font-size:.9rem; padding-left:18px; }
    .rules li { margin-bottom:4px; }
    [hidden] { display:none !important; }
    @media (max-width:380px) { .picker { grid-template-columns:repeat(3,1fr); } }
  </style>
</head>
<body>
  <main class="wrap">
    <a class="back" href="./">← Back to portfolio</a>
    <h1>Number <span>Guessing Game</span></h1>
    <p class="sub">Web version of my C++ console game. Guess two numbers from 0 to 5 and bet your coins.</p>

    <section class="card coins" aria-live="polite">
      <div><div class="label">Your coins</div><div class="value" id="coins">1000</div></div>
      <button class="chip" id="restart" type="button" hidden>New game</button>
    </section>

    <section class="card" id="play">
      <h2 id="g1">Guess number 1</h2>
      <div class="picker" id="pick1" role="group" aria-labelledby="g1"></div>
      <h2 id="g2">Guess number 2</h2>
      <div class="picker" id="pick2" role="group" aria-labelledby="g2"></div>
      <h2><label for="bet">Your bet</label></h2>
      <div class="bet-row">
        <input id="bet" type="number" inputmode="numeric" min="1" step="1" value="100" />
        <button class="chip" type="button" data-bet="0.25">25%</button>
        <button class="chip" type="button" data-bet="0.5">50%</button>
        <button class="chip" type="button" data-bet="1">All in</button>
      </div>
      <div class="hint">Bet at least 1 coin and no more than you have.</div>
      <div class="error" id="error" role="alert"></div>
      <button class="btn" id="go" type="button">Play round</button>
    </section>

    <section class="card result" id="result" hidden aria-live="polite">
      <div class="draws" id="draws"></div>
      <div class="msg" id="msg"></div>
      <button class="btn secondary" id="again" type="button">Play again</button>
    </section>

    <section class="card">
      <h2>Rules</h2>
      <ul class="rules">
        <li>Both guesses correct: win 2x your bet.</li>
        <li>One guess correct: win 1x your bet.</li>
        <li>No guess correct: lose your bet.</li>
        <li>The game ends when you run out of coins.</li>
      </ul>
    </section>
  </main>

  <script>
    let coins = 1000;
    let guess = [null, null];

    const $ = id => document.getElementById(id);
    const coinsEl = $('coins'), betEl = $('bet'), errorEl = $('error');

    // Build the 0-5 buttons for each guess
    [['pick1', 0], ['pick2', 1]].forEach(([id, slot]) => {
      const box = $(id);
      for (let n = 0; n <= 5; n++) {
        const b = document.createElement('button');
        b.type = 'button'; b.textContent = n; b.setAttribute('aria-pressed', 'false');
        b.addEventListener('click', () => {
          guess[slot] = n;
          box.querySelectorAll('button').forEach(x => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
          errorEl.textContent = '';
        });
        box.appendChild(b);
      }
    });

    // Same rules as the C++ version: count matches, then update coins
    function countMatches(g1, a1, g2, a2) {
      return (g1 === a1 ? 1 : 0) + (g2 === a2 ? 1 : 0);
    }
    function updateCoins(matches, bet) {
      if (matches === 2) coins += bet * 2;
      else if (matches === 1) coins += bet;
      else coins -= bet;
    }

    document.querySelectorAll('[data-bet]').forEach(b =>
      b.addEventListener('click', () => { betEl.value = Math.max(1, Math.floor(coins * Number(b.dataset.bet))); }));

    $('go').addEventListener('click', () => {
      const bet = Number(betEl.value);
      if (guess[0] === null || guess[1] === null) { errorEl.textContent = 'Pick both numbers first.'; return; }
      if (!Number.isInteger(bet) || bet < 1 || bet > coins) { errorEl.textContent = `Enter a whole-number bet from 1 to ${coins}.`; return; }
      errorEl.textContent = '';

      const r1 = Math.floor(Math.random() * 6);
      const r2 = Math.floor(Math.random() * 6);
      const matches = countMatches(guess[0], r1, guess[1], r2);
      updateCoins(matches, bet);
      coinsEl.textContent = coins;

      $('draws').innerHTML = [[r1, guess[0]], [r2, guess[1]]].map(([r, g]) =>
        `<div class="die ${r === g ? 'hit' : 'miss'}"><b>${r}</b><small>you: ${g}</small></div>`).join('');
      const msg = $('msg');
      msg.className = 'msg ' + (matches > 0 ? 'win' : 'lose');
      msg.textContent = matches === 2 ? `Both correct! You won ${bet * 2} coins.`
                      : matches === 1 ? `One correct. You won ${bet} coins.`
                      : `No match. You lost ${bet} coins.`;
      $('result').hidden = false;

      if (coins <= 0) {
        msg.textContent += ' You ran out of coins!';
        $('play').hidden = true; $('again').hidden = true; $('restart').hidden = false;
      } else {
        betEl.max = coins;
        if (Number(betEl.value) > coins) betEl.value = coins;
      }
    });

    $('again').addEventListener('click', () => {
      $('result').hidden = true;
      guess = [null, null];
      document.querySelectorAll('.picker button').forEach(b => b.setAttribute('aria-pressed', 'false'));
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    $('restart').addEventListener('click', () => {
      coins = 1000; coinsEl.textContent = coins; betEl.value = 100;
      guess = [null, null];
      document.querySelectorAll('.picker button').forEach(b => b.setAttribute('aria-pressed', 'false'));
      $('play').hidden = false; $('again').hidden = false; $('result').hidden = true; $('restart').hidden = true;
    });
  </script>
</body>
</html>
